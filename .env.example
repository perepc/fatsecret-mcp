FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# OAuth 1.0 Consumer Secret (different from Client Secret, see API Keys page)
FATSECRET_CONSUMER_SECRET=

# HTTP (Vercel) deployment: comma-separated API keys accepted on /api/mcp
# Generate one with: openssl rand -hex 32
MCP_API_KEYS=
# Redis REST store (injected by Vercel Marketplace Redis/Upstash); persists OAuth 1.0 user tokens
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: set OAuth 1.0 user tokens by hand (override the store)
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_TOKEN_SECRET=
